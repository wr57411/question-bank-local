# 服务端配置（复制为 server/.env 后修改）

# JWT 签名密钥（必须设置，建议使用随机生成的 32+ 字符字符串）
JWT_SECRET=change-this-to-a-random-secret

# 服务端口
PORT=3001

# 可选：主从同步（留空则不启用）
PRIMARY_SERVER_URL=

# 可选：Supabase 云复制
SUPABASE_URL=
SUPABASE_KEY=

# 可选：GitHub 反馈 Issue（留空则反馈提交不可用）
# PAT 需要仓库 Contents 读写权限（经典 token 勾选 repo，或 fine-grained 勾选 Contents: Read and write）
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_FEEDBACK_BRANCH=feedback-assets
GITHUB_BASE_BRANCH=main
GITHUB_ISSUE_LABELS=user-feedback

# --- 语义编码服务地址（每个引擎各一个）---
# 默认地址：未配置引擎专属变量时使用
EMBED_SERVICE_URL=http://127.0.0.1:3002
# 引擎专属地址：EMBED_SERVICE_URL__<ENGINE_ID>
#   <ENGINE_ID> 规则：先转大写，再把所有非字母数字字符替换为下划线（_）
#   例：engineId=mac-mps    → EMBED_SERVICE_URL__MAC_MPS
#       engineId=linux-cuda → EMBED_SERVICE_URL__LINUX_CUDA
#   未配置的引擎回退到上面的 EMBED_SERVICE_URL
EMBED_SERVICE_URL__MAC_MPS=
EMBED_SERVICE_URL__LINUX_CUDA=

