{
  "name": "question-bank-local",
  "version": "1.0.0",
  "description": "本地题库管理应用 - 无需联网",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ server/src/",
    "lint:fix": "eslint src/ server/src/ --fix",
    "format": "prettier --write src/ server/src/",
    "test": "vitest run",
    "test:unit": "vitest run unit-tests",
    "test:ai": "bash scripts/run-ai-tests.sh all",
    "test:ai:unit": "bash scripts/run-ai-tests.sh unit",
    "test:ai:real": "bash scripts/run-ai-tests.sh api",
    "test:e2e": "playwright test",
    "test:e2e:pw": "playwright test",
    "test:e2e:pw:debug": "playwright test --debug",
    "test:e2e:pw:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test",
    "validate:e2e": "node scripts/validate-e2e.js",
    "cap:init": "npx cap init question-bank-local com.questionbank.local --web-dir www",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:run:android": "npx cap run android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync:ios": "npx cap sync ios && bash scripts/ios-plist-patch.sh",
    "cap:open:ios": "npx cap open ios",
    "cap:run:ios": "npx cap run ios",
    "ship": "bash scripts/ship-feature.sh",
    "build:apk": "bash scripts/ship-feature.sh",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^6.0.1",
    "@capacitor-community/media": "^7.0.1",
    "@capacitor/android": "^6.0.0",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/clipboard": "^6.0.1",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/ios": "^6.2.1",
    "@hotend/capacitor-file-picker": "^6.0.101",
    "dompurify": "^3.2.4",
    "jspdf": "^2.5.1",
    "localforage": "^1.10.0",
    "pdfjs-dist": "^6.1.200"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "serve": "^14.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.8"
  }
}
