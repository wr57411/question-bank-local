# ============================================
# 本地题库 - 环境变量配置模板
# 复制为 .env 后填入真实值：cp .env.example .env
# ============================================

# --- AI 测试配置 ---
# 获取密钥: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# --- 测试配置 ---
# 服务端地址（Vite 开发代理目标）
TEST_SERVER_URL=http://localhost:3001
# 测试账号（需在服务端注册过的手机号+密码）
TEST_PHONE=your-test-phone
TEST_PASSWORD=your-test-password

# E2E 专用测试账号（server/scripts/e2e-account-reset.mjs 使用）
# MAIN_ACCOUNT_PHONE: 主账号手机号（快照数据来源）
# E2E_TEST_PHONE / E2E_TEST_PASSWORD: 隔离测试账号凭据（首次运行脚本自动生成）
MAIN_ACCOUNT_PHONE=
E2E_TEST_PHONE=
E2E_TEST_PASSWORD=
