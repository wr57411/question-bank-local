# ============================================
# 本地题库 - 环境变量配置模板
# 复制为 .env 后填入真实值：cp .env.example .env
# ============================================

# --- AI 测试配置 ---
# 获取密钥: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# --- 测试配置 ---
# 服务端地址（Vite 开发代理目标）
TEST_SERVER_URL=http://localhost:3001
# 测试账号（需在服务端注册过的手机号+密码）
TEST_PHONE=your-test-phone
TEST_PASSWORD=your-test-password
