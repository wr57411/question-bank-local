/**
 * <%= pipeline.name %> Mock 集成测试
 * 自动生成 by ai-test-harness
 * 测试: mock fetch + 完整管线（解析 -> 校验 -> 状态流转）
 */
import { describe, it, expect, vi, beforeEach } from 'vitest'
import { readFileSync } from 'fs'
import { resolve } from 'path'
import { parse, aggregateContent, validate, validateContent } from '../helpers/ai-test-lib.js'

const FIXTURE_DIR = resolve(process.cwd(), '<%= fixtureDir %>')

function buildMockSSEResponse(content) {
  const chunks = []
  const words = content.split('')
  let i = 0
  while (i < words.length) {
    const size = Math.min(3, words.length - i)
    const chunk = words.slice(i, i + size).join('')
    chunks.push({ choices: [{ delta: { content: chunk } }] })
    i += size
  }
  return chunks.map(c => `data: ${JSON.stringify(c)}\n`).join('') + 'data: [DONE]\n'
}

function createMockFetch(responseText, status = 200) {
  const sseBody = buildMockSSEResponse(responseText)
  const encoder = new TextEncoder()
  const body = new ReadableStream({
    start(controller) {
      controller.enqueue(encoder.encode(sseBody))
      controller.close()
    }
  })
  return vi.fn().mockResolvedValue({
    ok: status >= 200 && status < 300,
    status,
    text: () => Promise.resolve(responseText),
    body
  })
}

describe('<%= pipeline.name %> - Mock 集成测试', () => {

  describe('管线全链路（mock fetch）', () => {

    it('正常响应 -> 解析成功 -> schema 校验通过', async () => {
      const fixture = readFileSync(resolve(FIXTURE_DIR, '<%= pipeline.name %>_good.json'), 'utf8')
      const mockFetch = createMockFetch(fixture)
      globalThis.fetch = mockFetch

      const response = await fetch('<%= api.baseUrl %>/chat/completions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ model: '<%= api.testModel %>', messages: [] })
      })

      expect(response.ok).toBe(true)
      const text = await response.text()
      const parsed = parse(text)
      expect(parsed.data).not.toBeNull()
<% if (pipeline.outputSchema) { %>
      const schema = <%- JSON.stringify(pipeline.outputSchema) %>
      const validation = validate(parsed.data, schema)
      expect(validation.valid).toBe(true)
<% } %>
    })

    it('脏数据（markdown包裹）-> 提取成功', () => {
      const fixture = readFileSync(resolve(FIXTURE_DIR, '<%= pipeline.name %>_markdown_wrapped.txt'), 'utf8')
      const parsed = parse(fixture)
      expect(parsed.data).not.toBeNull()
      expect(Array.isArray(parsed.data)).toBe(true)
    })
  })

  describe('错误注入', () => {

    it('API 返回 401 -> 应识别为权限错误', async () => {
      const mockFetch = vi.fn().mockResolvedValue({
        ok: false,
        status: 401,
        text: () => Promise.resolve('Unauthorized')
      })
      globalThis.fetch = mockFetch

      const response = await fetch('<%= api.baseUrl %>/chat/completions')
      expect(response.ok).toBe(false)
      expect(response.status).toBe(401)
    })

    it('API 返回 429 -> 应识别为限流', async () => {
      const mockFetch = vi.fn().mockResolvedValue({
        ok: false,
        status: 429,
        text: () => Promise.resolve('Rate limit exceeded')
      })
      globalThis.fetch = mockFetch

      const response = await fetch('<%= api.baseUrl %>/chat/completions')
      expect(response.ok).toBe(false)
      expect(response.status).toBe(429)
    })

    it('截断响应 -> 解析失败', () => {
      const fixture = readFileSync(resolve(FIXTURE_DIR, '<%= pipeline.name %>_truncated.txt'), 'utf8')
      const parsed = parse(fixture)
      expect(parsed.data).toBeNull()
      expect(parsed.errors.length).toBeGreaterThan(0)
    })

    it('空响应 -> 解析失败', () => {
      const fixture = readFileSync(resolve(FIXTURE_DIR, '<%= pipeline.name %>_empty.txt'), 'utf8')
      const parsed = parse(fixture)
      expect(parsed.data).toBeNull()
    })
  })
})
